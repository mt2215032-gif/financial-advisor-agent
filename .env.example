# Copy to .env and fill in. .env is gitignored.

# ---------------------------------------------------------------------------
# Which provider to run on: anthropic | openai | ollama | compatible
# ---------------------------------------------------------------------------
LLM_PROVIDER=anthropic

# Overrides the model for whichever provider is selected. Leave unset to use
# the per-provider variables below.
# LLM_MODEL=

# Applies to providers that accept it (OpenAI, Ollama, compatible endpoints).
# Claude Opus 5 rejects temperature, so it is never sent there.
# LLM_TEMPERATURE=0.4


# --- Claude (Anthropic) ----------------------------------------------------
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-5
# ANTHROPIC_EFFORT=medium          # low | medium | high | xhigh | max


# --- OpenAI ----------------------------------------------------------------
# https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o


# --- Ollama (local open-source models) -------------------------------------
# Install from https://ollama.com, then: ollama pull llama3.1
# No API key - the model runs on your machine.
# OLLAMA_MODEL=llama3.1
# OLLAMA_BASE_URL=http://localhost:11434


# --- Any OpenAI-compatible endpoint ----------------------------------------
# Groq, Together, OpenRouter, Fireworks, vLLM, LM Studio, ...
# OPENAI_COMPATIBLE_API_KEY=...
# OPENAI_COMPATIBLE_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_COMPATIBLE_MODEL=llama-3.3-70b-versatile
